+// An empty glob searches every file and context above 5 caps to 5;
+// context 0 still shows no lines.
+func TestIndexGrepGlobContextPlaceholders(t *testing.T) {
+	requireRipgrep(t)
+	h := newHarness(t)
+	os.MkdirAll(filepath.Join(h.root, "pkg"), 0o755)
+	var b strings.Builder
+	for i := 1; i <= 13; i++ {
+		if i == 7 {
+			b.WriteString("needle here\n")
+		} else {
+			fmt.Fprintf(&b, "line %02d\n", i)
+		}
+	}
+	os.WriteFile(filepath.Join(h.root, "pkg", "a.py"), []byte(b.String()), 0o600)
+	os.WriteFile(filepath.Join(h.root, "pkg", "b.txt"), []byte("needle in text\n"), 0o600)
+	if got := grepResult(t, h.mustEval(t, `(index-grep "pkg" "needle" "")`)); len(got.Matches) != 2 {
+		t.Fatalf("empty glob: %+v", got)
+	}
+	// Six lines of context are available on each side; above 5 caps to 5.
+	for _, n := range []string{"6", "8", "10"} {
+		got := grepResult(t, h.mustEval(t, `(index-grep "pkg" "needle" "*.py" `+n+`)`))
+		if len(got.Matches) != 1 || len(got.Matches[0].Before) != 5 || len(got.Matches[0].After) != 5 {
+			t.Fatalf("context %s caps to 5: %+v", n, got)
+		}
+	}
+	if got := grepResult(t, h.mustEval(t, `(index-grep "pkg" "needle" "*.py" 0)`)); len(got.Matches) != 1 || len(got.Matches[0].Before) != 0 {
+		t.Fatalf("context 0: %+v", got)
+	}
+}
