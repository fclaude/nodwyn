+// A skipped start (0) reads from line 1, and a skipped count (0) is the
+// default; only a truly invalid start still errors.
+func TestFsReadSkippedStart(t *testing.T) {
+	h := newHarness(t)
+	var b strings.Builder
+	for i := 1; i <= 10; i++ {
+		fmt.Fprintf(&b, "line %04d\n", i)
+	}
+	os.WriteFile(filepath.Join(h.root, "big.txt"), []byte(b.String()), 0o644)
+	if got := h.mustEval(t, `(fs-read "big.txt" 0 2)`).S; got != "[lines 1-2 of 10]\nline 0001\nline 0002\n" {
+		t.Fatalf("start 0: %q", got)
+	}
+	// No range at all (both skipped) is the whole-file read.
+	if got, whole := h.mustEval(t, `(fs-read "big.txt" 0 0)`).S, h.mustEval(t, `(fs-read "big.txt")`).S; got != whole {
+		t.Fatalf("start 0 count 0 is the whole file: %q", got)
+	}
+	// A count without a start reads from line 1 with that count.
+	if got := h.mustEval(t, `(fs-read "big.txt" 0 3)`).S; got != "[lines 1-3 of 10]\nline 0001\nline 0002\nline 0003\n" {
+		t.Fatalf("count without start: %q", got)
+	}
+	if _, err := h.eval(t, `(fs-read "big.txt" -1)`); err == nil || !strings.Contains(err.Error(), "start is a 1-based line number") {
+		t.Fatalf("start -1: %v", err)
+	}
+}
