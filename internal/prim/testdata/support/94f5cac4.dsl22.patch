+		}}, Handler: func(c *Call) (Value, error) { return Void, nil }}
+	}
+	for _, raw := range []string{`{"path":"p","count":4}`, `{"path":"p","start":null,"count":4}`} {
+		args, err := mk().ArgsFromJSON([]byte(raw))
+		if err != nil {
+			t.Fatalf("%s: %v", raw, err)
+		}
+		if len(args) != 3 || Write(args[0]) != `"p"` || Write(args[1]) != "0" || Write(args[2]) != "4" {
+			t.Fatalf("%s: got %q %q %q", raw, Write(args[0]), Write(args[1]), Write(args[2]))
+		}
+	}
+	gmk := func() *Prim {
+		return &Prim{Name: "grep", Meta: Meta{Doc: "d", Host: true, Params: []Param{
+			{Name: "path", Type: "string"},
+			{Name: "pattern", Type: "string"},
+			{Name: "glob", Type: "string", Optional: true},
+			{Name: "context", Type: "integer", Optional: true},
+		}}, Handler: func(c *Call) (Value, error) { return Void, nil }}
+	}
+	args, err := gmk().ArgsFromJSON([]byte(`{"path":"pkg","pattern":"needle","context":2}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(args) != 4 || Write(args[2]) != `""` || Write(args[3]) != "2" {
+		t.Fatalf("glob placeholder: %q %q", Write(args[2]), Write(args[3]))
+	}
+}
