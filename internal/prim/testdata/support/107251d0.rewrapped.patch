+// The chat fake refuses a message with role "system" in the input the way
+// OpenAI's plan server refused it in session 20261007T152356Z-a337f2a9, and
+// accepts the same prompt as the request's instructions: a client still on
+// the old wire fails instead of passing.
+func TestTheResponsesFakeRefusesASystemItemInInput(t *testing.T) {
+	t.Parallel()
+	srv := chat.New("", chat.Model{ID: "sol"})
+	t.Cleanup(srv.Close)
+	raw := func(body string) (int, string) {
+		resp, err := http.Post(srv.V1()+"/responses", "application/json", strings.NewReader(body))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		b, err := io.ReadAll(resp.Body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return resp.StatusCode, string(b)
+	}
+	status, detail := raw(`{"model":"sol","input":[{"type":"message","role":"system","content":"sys"},{"type":"message","role":"user","content":"hi"}],"stream":true,"store":false}`)
+	if status != http.StatusBadRequest || detail != `{"detail":"System messages are not allowed"}` {
+		t.Fatalf("a system item in input: got %d %s", status, detail)
+	}
+	status, detail = raw(`{"model":"sol","instructions":"sys","input":[{"type":"message","role":"user","content":"hi"}],"stream":true,"store":false}`)
+	if status != http.StatusOK {
+		t.Fatalf("the same conversation as instructions: got %d %s", status, detail)
+	}
+}
