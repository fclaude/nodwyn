+// A message with role "system" in input is refused the way OpenAI's plan
+// server refused it in session 20261007T152356Z-a337f2a9; the same
+// conversation with the prompt as instructions goes through.
+func TestResponsesRefusesSystemInputItem(t *testing.T) {
+	srv, _ := responsesServer(t, `{"status":"completed","output":[]}`)
+	raw := func(body string) (int, string) {
+		resp, err := http.Post(srv.URL+"/v1/responses", "application/json", strings.NewReader(body))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		b, err := io.ReadAll(resp.Body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return resp.StatusCode, string(b)
+	}
+	status, detail := raw(`{"model":"gpt-6.1-sol","input":[{"type":"message","role":"system","content":"sys"},{"type":"message","role":"user","content":"hi"}],"stream":true,"store":false}`)
+	if status != http.StatusBadRequest || detail != `{"detail":"System messages are not allowed"}` {
+		t.Fatalf("a system item in input: got %d %s", status, detail)
+	}
+	status, detail = raw(`{"model":"gpt-6.1-sol","instructions":"sys","input":[{"type":"message","role":"user","content":"hi"}],"stream":true,"store":false}`)
+	if status != http.StatusOK || detail != `{"status":"completed","output":[]}` {
+		t.Fatalf("the same conversation as instructions: got %d %s", status, detail)
+	}
+}
