+// A stream that ends without a terminal event names its Content-Type, which
+// redaction has seen, rather than its body, which it has not.
+func TestResponsesMissingTerminalNamesContentType(t *testing.T) {
+	for _, contentType := range []string{"", "application/json", "text/plain"} {
+		t.Run("type="+contentType, func(t *testing.T) {
+			body := "event: response.created\n\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"partial-secret\"}\n\n"
+			if contentType == "" {
+				// A test server always sniffs a Content-Type, so an
+				// absent one is built directly: nothing names it.
+				_, err := readResponses(&http.Response{Header: http.Header{}, Body: io.NopCloser(strings.NewReader(body))})
+				if err == nil {
+					t.Fatal("want missing-terminal error, got nil")
+				}
+				if want := `Content-Type ""`; !strings.Contains(err.Error(), want) {
+					t.Fatalf("want %q in %v", want, err)
+				}
+				if strings.Contains(err.Error(), "partial-secret") {
+					t.Fatalf("error quotes unseen body: %v", err)
+				}
+				return
+			}
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", contentType)
+				fmt.Fprint(w, body)
+			}))
+			defer srv.Close()
+			o := NewOpenAI(srv.URL, nil)
+			o.Dialect = ChatResponses
+			_, err := o.Chat(context.Background(), Request{Model: "test"}, nil)
+			if err == nil {
+				t.Fatal("want missing-terminal error, got nil")
+			}
+			if want := fmt.Sprintf("Content-Type %q", contentType); !strings.Contains(err.Error(), want) {
+				t.Fatalf("want %q in %v", want, err)
+			}
+			if strings.Contains(err.Error(), "partial-secret") {
+				t.Fatalf("error quotes unseen body: %v", err)
+			}
+		})
+	}
+}
