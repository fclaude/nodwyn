+	// Context above the limit caps to 5 instead of refusing: with 10 lines
+	// on each side of the match, an uncapped 6, 8 or 10 would return more
+	// than 5 before/after lines.
+	var sb strings.Builder
+	for i := 1; i <= 21; i++ {
+		if i == 11 {
+			sb.WriteString("capneedle\n")
+		} else {
+			fmt.Fprintf(&sb, "line %d\n", i)
+		}
+	}
+	os.WriteFile(filepath.Join(h.root, "pkg", "big.py"), []byte(sb.String()), 0o600)
+	for _, n := range []int{6, 8, 10} {
+		got := grepResult(t, h.mustEval(t, fmt.Sprintf(`(index-grep "pkg" "capneedle" "big.py" %d)`, n)))
+		if len(got.Matches) != 1 || len(got.Matches[0].Before) != 5 || len(got.Matches[0].After) != 5 {
+			t.Fatalf("context %d capped to 5: %+v", n, got)
+		}
+	}
