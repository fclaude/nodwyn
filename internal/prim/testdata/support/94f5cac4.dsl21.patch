+// Start 0 is line 1: a skipped start filled with 0 reads from the top.
+func TestFsReadStartZero(t *testing.T) {
+	h := newHarness(t)
+	os.WriteFile(filepath.Join(h.root, "z.txt"), []byte("a\nb\nc\n"), 0o644)
+	want := h.mustEval(t, `(fs-read "z.txt" 1 2)`).S
+	if got := h.mustEval(t, `(fs-read "z.txt" 0 2)`).S; got != want {
+		t.Errorf("start 0:\n%q\nwant\n%q", got, want)
+	}
+}
