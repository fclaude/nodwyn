+
+// A skipped optional before a later given one fills its type's empty value:
+// string "", integer 0, boolean #f, list ().
+func TestOptionalParametersByName(t *testing.T) {
+	p := &Prim{Name: "m", Meta: Meta{Doc: "d", Params: []Param{
+		{Name: "req", Type: "string"},
+		{Name: "s", Type: "string", Optional: true},
+		{Name: "n", Type: "integer", Optional: true},
+		{Name: "b", Type: "boolean", Optional: true},
+		{Name: "l", Type: "list", Optional: true},
+	}}}
+	for raw, want := range map[string]string{
+		`{"req":"r","n":2,"l":[1]}`: `("r" "" 2 #f (1))`,
+		`{"req":"r","l":[1]}`:       `("r" "" 0 #f (1))`,
+		`{"req":"r"}`:               `("r")`,
+		`{"req":"r","s":null,"n":null,"b":null,"l":null}`: `("r")`,
+	} {
+		args, err := p.ArgsFromJSON([]byte(raw))
+		if err != nil || Write(List(args...)) != want {
+			t.Errorf("%s: got %q, %v; want %s", raw, Write(List(args...)), err, want)
+		}
+	}
+	// Vector and alist skipped optionals fill their empty values too.
+	q := &Prim{Name: "q", Meta: Meta{Doc: "d", Params: []Param{
+		{Name: "req", Type: "string"},
+		{Name: "v", Type: "vector", Optional: true},
+		{Name: "a", Type: "alist", Optional: true},
+		{Name: "tail", Type: "integer", Optional: true},
+	}}}
+	for raw, want := range map[string]string{
+		`{"req":"r","tail":9}`: `("r" #() () 9)`,
+	} {
+		args, err := q.ArgsFromJSON([]byte(raw))
+		if err != nil || Write(List(args...)) != want {
+			t.Errorf("%s: got %q, %v; want %s", raw, Write(List(args...)), err, want)
+		}
+	}
+}
