+// A stream that ends without its terminal event names its Content-Type in the
+// error, not its body (which redaction has not seen, ADR 25).
+func TestResponsesMissingTerminalNamesTheContentType(t *testing.T) {
+	stream := "event: response.created\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"partial\"}\n\n"
+	for _, ct := range []string{"", "application/json", "text/plain", "text/event-stream"} {
+		h := http.Header{}
+		if ct != "" {
+			h.Set("Content-Type", ct)
+		}
+		resp := &http.Response{Header: h, Body: io.NopCloser(strings.NewReader(stream))}
+		_, err := readResponses(resp)
+		if err == nil {
+			t.Fatalf("content type %q: want an error", ct)
+		}
+		if !strings.Contains(err.Error(), "ended without a terminal response") {
+			t.Fatalf("content type %q: %v", ct, err)
+		}
+		want := ct
+		if want == "" {
+			want = "none"
+		}
+		if !strings.Contains(err.Error(), `content type "`+want+`"`) {
+			t.Fatalf("content type %q not named: %v", ct, err)
+		}
+		// The body must not leak into the error.
+		if strings.Contains(err.Error(), "partial") {
+			t.Fatalf("content type %q: the body leaked into the error: %v", ct, err)
+		}
+	}
+}
